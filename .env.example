# Variáveis de ambiente da Lumine
# Copie este arquivo para .env e preencha os valores.
# NUNCA suba o arquivo .env preenchido para o GitHub!

# ─── Discord ───────────────────────────────────────────────────────────────────
# Token do bot no Discord Developer Portal
DISCORD_TOKEN=seu_discord_token_aqui

# ─── Lavalink ──────────────────────────────────────────────────────────────────
# URI do nó Lavalink local ou externo (opcional, o código usa 127.0.0.1:2333 por padrão)
LAVALINK_URI=http://127.0.0.1:2333

# Senha do servidor Lavalink (deve ser igual ao configurado no application.yml do Lavalink)
LAVALINK_PASSWORD=youshallnotpass

# ─── Controle do Lavalink local ────────────────────────────────────────────────
# false = não tenta iniciar o Lavalink.jar localmente (use no Railway/servidor)
# true  = tenta iniciar o Lavalink local (use no PC local com Java instalado)
LAVALINK_MANAGED=true

# ─── YouTube OAuth ─────────────────────────────────────────────────────────────
# Token gerado na primeira execução do Lavalink para contornar bloqueios do YouTube.
# Deixe em branco caso não tenha configurado OAuth2 no YouTube.
YOUTUBE_REFRESH_TOKEN=seu_youtube_refresh_token_aqui

# ─── Spotify (Desativado atualmente) ───────────────────────────────────────────
# Guardado aqui para quando for reativado no código
SPOTIFY_CLIENT_ID=seu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_spotify_client_secret_aqui
