# Variáveis de ambiente da Lumine
# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o GitHub!

# ─── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=seu_token_aqui

# ─── Lavalink ──────────────────────────────────────────────────────────────────
# URI do nó Lavalink (use wss:// para SSL, ws:// ou http:// para sem SSL)
# Exemplos de nós públicos gratuitos:
#   ws://lava.link:80           senha: disforge.com
#   wss://lavalink.devamop.in   senha: DevamOP
#   ws://lavalink.serux.pro:2333 senha: serux.pro
# Lista completa: https://github.com/DarrenOfficial/lavalink-list
LAVALINK_URI=ws://lava.link:80
LAVALINK_PASSWORD=disforge.com

# ─── Controle do Lavalink local ────────────────────────────────────────────────
# false = não tenta iniciar o Lavalink.jar localmente (use no Railway/servidor)
# true  = tenta iniciar o Lavalink local (use no PC com Java instalado)
LAVALINK_MANAGED=false
